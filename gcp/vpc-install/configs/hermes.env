# Appended to ~/.hermes/.env by 02-vm-install.sh.
# Non-secret runtime pointers only. Secrets (dashboard password, Honcho LLM
# keys) are written separately and never committed to this repo.

# --- Self-hosted SearXNG (localhost — never exposed) -----------------------
# Presence of this variable is what makes the `searxng` web backend "available"
# to Hermes; the provider reads it via Hermes' config-aware env lookup.
SEARXNG_URL=http://localhost:__SEARXNG_PORT__

# --- Self-hosted Honcho memory (localhost — never exposed) ----------------
# HONCHO_BASE_URL is what switches Honcho from its cloud default to self-hosted.
# HONCHO_API_KEY is intentionally absent: it is only used for Honcho cloud.
HONCHO_BASE_URL=http://localhost:__HONCHO_PORT__

# --- Vertex AI ------------------------------------------------------------
# No API key here on purpose. The `vertex` provider authenticates with the VM's
# attached service account (Application Default Credentials). Do NOT set
# GOOGLE_API_KEY / GEMINI_API_KEY — those select the `gemini` (AI Studio)
# provider instead and cause HTTP 400 "no access to model".
GOOGLE_CLOUD_PROJECT=__PROJECT_ID__
GOOGLE_CLOUD_LOCATION=__VERTEX_REGION__

# --- Gateway ---------------------------------------------------------------
# Idle timeout in seconds before the gateway tears down an inactive agent run.
HERMES_AGENT_TIMEOUT=__HERMES_AGENT_TIMEOUT__
# Raise if very large contexts time out mid-stream.
HERMES_STREAM_READ_TIMEOUT=1800
