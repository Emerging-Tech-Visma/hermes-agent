<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS LaunchAgent that keeps the secure gateway (IAP tunnel) up.

  Without this the tunnel dies on sleep/reboot and the desktop app shows
  "Remote gateway sign-in required" every morning. Reconnect after wake takes
  ~20-40s (launchd throttle + gcloud cold start), so give it a moment.

  KeepAlive alone is NOT sufficient and never was: gcloud's start-iap-tunnel holds
  the local port open and retries internally forever when its token cannot refresh,
  so it never dies and KeepAlive never fires. This agent therefore runs
  scripts/gateway-tunnel-supervisor.sh, which probes the tunnel over HTTP and
  restarts it when it stops forwarding. Logs live in
  ~/Library/Logs/hermes-gateway-tunnel.log (rotated).

  Install — use the script, which fills in the placeholders below from 00-vars.sh
  and `which gcloud`, removes any stale agent, and verifies the tunnel:

    bash gcp/vpc-install/scripts/install-gateway-launchagent.sh

  This file is a TEMPLATE: the placeholders are not valid launchd values, so do not
  copy it into ~/Library/LaunchAgents/ by hand. Hand-editing was the old procedure and
  it had two reliable failure modes: a bare "gcloud" (launchd reads no shell profile)
  and a literal <you> left in HOME, which fails with a credentials error that looks
  like an IAM problem.

  Manage:
    launchctl kickstart -k gui/$(id -u)/com.hermes.gateway-tunnel   # force reconnect
    launchctl bootout   gui/$(id -u)/com.hermes.gateway-tunnel      # stop + disable
    tail -f ~/Library/Logs/hermes-gateway-tunnel.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hermes.gateway-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Runs the SUPERVISOR, not gcloud directly. gcloud's start-iap-tunnel binds the
         port and then, if its token cannot refresh, retries forever WITHOUT EXITING —
         so launchd's KeepAlive never fires and the port stays bound but dead. The
         supervisor health-checks over HTTP and restarts the child. See its header. -->
    <string>/bin/bash</string>
    <string>__SUPERVISOR__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Don't hammer gcloud if it fails repeatedly. -->
  <key>ThrottleInterval</key>
  <integer>20</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with almost no environment: gcloud needs a sane PATH, and HOME
         to find the ADC credentials from `gcloud auth login`. -->
    <key>PATH</key>
    <string>__GCLOUD_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <!-- The tunnel authenticates as a SERVICE ACCOUNT, not as the human operator.
         Google enforces a periodic reauth on user credentials, and a LaunchAgent can
         never answer an interactive prompt — it just dies with "cannot prompt during
         non-interactive execution" and the gateway goes dark until someone notices.
         A service-account key is exempt from reauth, so this survives a week idle and
         a reboot. Empty when TUNNEL_USE_SA=false, which restores the old behaviour. -->
    <key>CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE</key>
    <string>__SA_KEY__</string>
    <!-- The installed supervisor lives in ~/.local/bin with NO 00-vars.sh beside it, so
         its config MUST arrive here. Leaving these out ships a supervisor that cannot
         find VM_NAME and dies instantly under `set -u` — the gateway then never comes up,
         while the repo checkout appears fine because a checkout DOES have 00-vars.sh.
         Re-run install-gateway-launchagent.sh to change any of these. -->
    <key>VM_NAME</key>
    <string>__VM_NAME__</string>
    <key>ZONE</key>
    <string>__ZONE__</string>
    <key>PROJECT_ID</key>
    <string>__PROJECT_ID__</string>
    <key>DASHBOARD_PORT</key>
    <string>__PORT__</string>
  </dict>

  <!-- The supervisor writes its own rotated log; this catches anything before that.
       The previous setup pointed gcloud's raw stderr here and it reached 27 MB /
       413k lines of repeated auth errors, because nothing rotated it. -->
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/hermes-gateway-tunnel.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/hermes-gateway-tunnel.launchd.log</string>
</dict>
</plist>
