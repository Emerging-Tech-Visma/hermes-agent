# ===========================================================================
# Honcho on VERTEX AI — zero external API keys, billed to the GCP project
# ---------------------------------------------------------------------------
# Appended to ~/honcho/.env by 02-vm-install.sh when MEMORY_LLM_BACKEND=vertex.
#
# HOW THIS WORKS
#
# Honcho has NO Vertex transport (src/config.py: ModelTransport = Literal[
# "anthropic", "openai", "gemini"]). So every module uses the `openai`
# transport pointed at the local shim (scripts/vertex-openai-proxy.py), which
# forwards to Vertex and injects a fresh service-account OAuth token per
# request.
#
# The shim exists because two things block talking to Vertex directly:
#   1. Vertex OAuth tokens expire hourly; Honcho wants a STATIC api_key. The
#      alternative is rewriting the token and restarting the containers every
#      45 minutes, forever.
#   2. Vertex's OpenAI-compat /embeddings endpoint is BROKEN — verified
#      2026-07-28, HTTP 500 "Internal error" for every model name, in both
#      `global` and `europe-west2`. The shim translates /v1/embeddings to the
#      native Vertex :predict API, which works fine.
#
# RESULT: no AI Studio key, no OpenAI key, no Anthropic key. Honcho's reasoning
# bills through the same service account as Hermes chat.
#
# __PROXY_URL__ is the compose-bridge gateway address of the VM host, detected
# at install time. If you ever `docker compose down` and the network is
# recreated on a different subnet, re-run 02-vm-install.sh to refresh it.
# ===========================================================================

# The shim ignores the key's value (it injects real auth itself), but the
# OpenAI SDK refuses to initialise without *something* non-empty here.
LLM_OPENAI_API_KEY=vertex-via-local-proxy

# --- Memory extraction (deriver) -------------------------------------------
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__

# --- Summarisation ---------------------------------------------------------
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=__HONCHO_MODEL__
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__

# --- Dialectic chat --------------------------------------------------------
# EVERY tier must be set. An unset tier silently falls back to the built-in
# openai default (api.openai.com + gpt-5.4-mini) and will fail with an invalid
# key, which looks like a proxy bug but isn't.
#
# ⚠️  KNOWN UPSTREAM LIMITATION — the `minimal` tier is output-starved, and it is NOT
# caused by our model choice. Honcho hardcodes MAX_OUTPUT_TOKENS=250 for `minimal`
# only (src/config.py, ~line 1064; every other tier gets the 8192 global default).
# Gemini reasoning models spend that budget on reasoning tokens before emitting
# content. Measured 2026-08-18 against a realistic 80-token dialectic prompt with
# max_tokens=250:
#
#   MODEL              reasoning   content   finish_reason   content chars
#   gemini-3.5-flash      237         9         length            39
#   gemini-2.5-flash    236-240      6-10       length          22-42
#
# The two models are indistinguishable here — the 250 ceiling truncates either one — so
# this is an upstream default worth knowing about, NOT a reason to pick one model over
# the other. (Separately, and for an unrelated reason, HONCHO_MODEL must stay on
# 2.5-flash: Gemini 3.x breaks Honcho's tool loop on missing thought_signatures. See
# 00-vars.sh.) Content here is truncated, not empty, so the tier still answers; it just
# answers briefly. Raise it with DIALECTIC_LEVELS__minimal__MAX_OUTPUT_TOKENS=1024 if
# you actually use that tier.
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__

# --- Dreaming (background consolidation) -----------------------------------
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=__HONCHO_MODEL__
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__

# --- Embeddings ------------------------------------------------------------
# Routed through the shim's translation layer to Vertex :predict.
# EMBEDDING_VECTOR_DIMENSIONS must match what the shim requests
# (VERTEX_EMBED_DIMENSIONS, default 1536) or every insert fails on a pgvector
# dimension mismatch. gemini-embedding-001 returns 3072 by default, so the
# shim explicitly asks for outputDimensionality=1536.
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=__HONCHO_EMBED_MODEL__
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=__PROXY_URL__
EMBEDDING_VECTOR_DIMENSIONS=__VERTEX_EMBED_DIMENSIONS__

# --- Auth ------------------------------------------------------------------
# Restated so a template change can't silently turn auth on and start 401-ing
# Hermes, which connects with NO key. Safe: Honcho is bound to 127.0.0.1.
AUTH_USE_AUTH=false
