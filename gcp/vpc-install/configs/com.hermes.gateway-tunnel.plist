<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS LaunchAgent that keeps the secure gateway (IAP tunnel) up.

  Without this the tunnel dies on sleep/reboot and the desktop app shows
  "Remote gateway sign-in required" every morning. KeepAlive restarts it
  automatically; reconnect after wake takes ~20-40s (launchd throttle +
  gcloud cold start), so give it a moment before the app reconnects.

  Install — use the script, which fills in the placeholders below from 00-vars.sh
  and `which gcloud`, removes any stale agent, and verifies the tunnel:

    bash gcp/vpc-install/scripts/install-gateway-launchagent.sh

  This file is a TEMPLATE: the placeholders are not valid launchd values, so do not
  copy it into ~/Library/LaunchAgents/ by hand. Hand-editing was the old procedure and
  it had two reliable failure modes: a bare "gcloud" (launchd reads no shell profile)
  and a literal <you> left in HOME, which fails with a credentials error that looks
  like an IAM problem.

  Manage:
    launchctl kickstart -k gui/$(id -u)/com.hermes.gateway-tunnel   # force reconnect
    launchctl bootout   gui/$(id -u)/com.hermes.gateway-tunnel      # stop + disable
    tail -f /tmp/hermes-gateway-tunnel.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hermes.gateway-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Absolute path: launchd does not read your shell profile, so a bare
         "gcloud" fails. Filled in from `which gcloud`. -->
    <string>__GCLOUD__</string>
    <string>compute</string>
    <string>start-iap-tunnel</string>
    <string>__VM_NAME__</string>
    <string>__PORT__</string>
    <string>--local-host-port=localhost:__PORT__</string>
    <string>--zone=__ZONE__</string>
    <string>--project=__PROJECT_ID__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Don't hammer gcloud if it fails repeatedly. -->
  <key>ThrottleInterval</key>
  <integer>20</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with almost no environment: gcloud needs a sane PATH, and HOME
         to find the ADC credentials from `gcloud auth login`. -->
    <key>PATH</key>
    <string>__GCLOUD_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/hermes-gateway-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hermes-gateway-tunnel.log</string>
</dict>
</plist>
