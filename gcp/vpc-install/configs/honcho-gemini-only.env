# ===========================================================================
# Honcho: Gemini-only configuration — ONE API key for the whole memory stack
# ---------------------------------------------------------------------------
# Appended to ~/honcho/.env by 02-vm-install.sh.
#
# WHY THIS FILE EXISTS
#
# Honcho validates at startup that EVERY configured provider has an API key and
# refuses to boot otherwise. Its shipped default points every module at the
# `openai` transport (verified in src/config.py: `transport: EmbeddingTransport =
# "openai"` plus transport="openai" defaults across the deriver / summary /
# dialectic / dream settings), so out of the box it needs LLM_OPENAI_API_KEY.
#
# ⚠️  The repo's own docs disagree with each other here — do not trust either
# blindly. docs/v3/contributing/troubleshooting.mdx says the default needs THREE
# keys (Gemini + Anthropic + OpenAI), while docs/v3/contributing/self-hosting.mdx
# says "if you keep the built-in defaults, you only need one API key" (OpenAI).
# src/config.py is the tiebreaker and agrees with self-hosting.mdx.
#
# This file overrides every module to the `gemini` transport, so the ONLY secret
# the memory stack needs is a single AI Studio key:
#
#     LLM_GEMINI_API_KEY=AIza...        # https://aistudio.google.com/apikey
#
# That keeps the whole stack on Google, matching the rest of this install, and
# reduces the non-GCP-billed surface from two or three keys to one.
#
# NOTE: this is an AI STUDIO key, not Vertex. Honcho has no Vertex support (grep
# -i vertex across the repo returns nothing), so it cannot use the VM's attached
# service account the way Hermes chat does. This is the one component not billed
# through the GCP project.
#
# Models must support TOOL CALLING (function calling). gemini-2.5-flash does and
# is the safe default; bump these to a newer AI Studio flash model if you have
# verified it works. AI Studio availability differs from Vertex — do not assume a
# model exists here just because Vertex serves it, or vice versa.
# ===========================================================================

# --- Memory extraction (deriver) -------------------------------------------
DERIVER_MODEL_CONFIG__TRANSPORT=gemini
DERIVER_MODEL_CONFIG__MODEL=gemini-2.5-flash

# --- Summarisation ---------------------------------------------------------
SUMMARY_MODEL_CONFIG__TRANSPORT=gemini
SUMMARY_MODEL_CONFIG__MODEL=gemini-2.5-flash

# --- Dialectic chat: every tier must be set, or an unset tier falls back to
#     the openai default and Honcho will demand an OpenAI key at startup.
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=gemini-2.5-flash
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=gemini
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=gemini-2.5-flash

# --- Dreaming (background consolidation) -----------------------------------
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=gemini
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=gemini-2.5-flash
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=gemini
DREAM_INDUCTION_MODEL_CONFIG__MODEL=gemini-2.5-flash

# --- Embeddings ------------------------------------------------------------
# EmbeddingTransport is Literal["openai", "gemini"], and config.py's
# _default_embedding_model_for_transport() returns "gemini-embedding-001" for
# gemini — set it explicitly so the intent survives a Honcho upgrade.
# Set EMBED_MESSAGES=false instead if you want to skip embeddings entirely.
EMBEDDING_MODEL_CONFIG__TRANSPORT=gemini
EMBEDDING_MODEL_CONFIG__MODEL=gemini-embedding-001

# --- Auth ------------------------------------------------------------------
# Already false in the shipped template; restated so a template change can't
# silently turn auth on and start 401-ing Hermes, which connects with NO key
# (HONCHO_API_KEY is for Honcho Cloud only). Safe because Honcho is bound to
# 127.0.0.1 on this VM. If you ever set AUTH_USE_AUTH=true you must also set
# AUTH_JWT_SECRET or the server refuses to boot.
AUTH_USE_AUTH=false
